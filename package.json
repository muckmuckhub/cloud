{
  "name": "cloud-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun build packages/cli/src/index.ts --compile --no-compile-autoload-dotenv --outfile dist/cloud",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run scripts/check-invariants.ts && bun run scripts/check-docs.ts",
    "examples": "bun run scripts/render-examples.ts",
    "links": "bun run scripts/check-links.ts",
    "demos": "bun run scripts/record-demos.ts",
    "docs": "mkdocs serve"
  },
  "devDependencies": {
    "@cloud/schema": "workspace:*",
    "bun-types": "^1.1.29",
    "smol-toml": "^1.3.0",
    "typescript": "^5.6.0",
    "yaml": "^2.5.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
