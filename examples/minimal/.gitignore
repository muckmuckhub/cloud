# What `cloud init` writes into a real network directory.
#
# Secrets.
.env
proxy/forwarding.secret

# Worlds and server data.
data/

# GENERATED by `cloud apply`. cloud.toml is the source of truth;
# committing these invites someone to edit them.
docker-compose.yml
proxy/velocity.toml
proxy/config.yml
proxy/patches/

# ...except here. This is an example, so the generated files are committed on
# purpose: they show what the renderers produce, and CI fails if they drift.
# Regenerate with `bun run examples`.
!docker-compose.yml
!proxy/velocity.toml
!proxy/config.yml
!proxy/patches/
