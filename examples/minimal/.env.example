# Copy to .env, then run ./gen-secret.sh to append FORWARDING_SECRET.

# Host port players connect to. Change if 25565 is taken.
ENTRY_PORT=25565

# Applies to every backend. Keep them on one version.
MC_VERSION=1.21.10

VELOCITY_VERSION=latest
MOTD=A Velocity Server

PROXY_MEMORY=512m
LOBBY_MEMORY=2G
SURVIVAL_MEMORY=4G

# FORWARDING_SECRET is appended by ./gen-secret.sh — do not set by hand.
